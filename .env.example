# Local OAuth is the default; no fallback when config is missing.
MCP_LOCAL_DEV=true
MCP_AUTH_MODE=oauth
DOCUMENT_BASE_URL=http://127.0.0.1:3007
CODING_LABS_BASE_URL=http://127.0.0.1:3009
PORT=3011
MCP_RESOURCE_URL=http://127.0.0.1:3011/mcp
AUTH_ISSUER_URL=http://127.0.0.1:3000
AUTH_INTROSPECTION_URL=http://127.0.0.1:3000/oauth/introspect
AUTH_INTROSPECTION_CLIENT_ID=ngx-workshop-gateway
# Privately set AUTH_INTROSPECTION_CLIENT_SECRET from auth config resourceClient.secret.
# For catalog-only regression startup explicitly use MCP_AUTH_MODE=local-public.

# Administrator publishing (independent of read-only catalog OAuth)
PUBLISHING_ENABLED=false
ASSESSMENT_BASE_URL=http://127.0.0.1:3005
UPLOADER_BASE_URL=http://127.0.0.1:3010
PUBLISHING_JOURNAL_DIRECTORY=/var/lib/ngx-publishing
# Set privately when enabling draft generation. No model default is assumed.
PUBLISHING_MODEL=
OPENAI_API_KEY=
# AuthClientService validates platform administrator credentials against this owner.
AUTH_BASE_URL=http://127.0.0.1:3000

# Optional publisher model catalog override: JSON array of id and nullable USD rates per 1M tokens.
# PUBLISHING_MODELS_JSON=[{"id":"gpt-6.1-sol","inputUsdPerMillion":2,"outputUsdPerMillion":10}]
# PUBLISHING_IMAGE_MODEL=gpt-image-2.5-sunburst
