{
  "openapi": "3.0.0",
  "paths": {
    "/.well-known/oauth-protected-resource/mcp": {
      "get": {
        "operationId": "OAuthMetadataController_metadata",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthResourceMetadataDto"
                }
              }
            }
          }
        },
        "summary": "OAuth protected MCP resource metadata",
        "tags": [
          "OAuthMetadata"
        ]
      }
    }
  },
  "info": {
    "title": "NGX Workshop catalog MCP contracts",
    "description": "MCP runs at /mcp. Components describe tool arguments/results; there are no REST CRUD endpoints. See mcp-tools.json for protocol tool definitions.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "OAuthResourceMetadataDto": {
        "type": "object",
        "properties": {
          "resource": {
            "type": "string"
          },
          "authorization_servers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scopes_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bearer_methods_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "resource",
          "authorization_servers",
          "scopes_supported",
          "bearer_methods_supported"
        ]
      },
      "ListWorkshopsInput": {
        "type": "object",
        "properties": {
          "sectionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "sectionId"
        ],
        "additionalProperties": false
      },
      "GetWorkshopInput": {
        "type": "object",
        "properties": {
          "sectionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "workshopId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "sectionId",
          "workshopId"
        ],
        "additionalProperties": false
      },
      "GetCodingLabInput": {
        "type": "object",
        "properties": {
          "labId": {
            "type": "string",
            "pattern": "^[a-f\\d]{24}$"
          },
          "versionId": {
            "type": "string",
            "pattern": "^[a-f\\d]{24}$"
          }
        },
        "required": [
          "labId"
        ],
        "additionalProperties": false
      },
      "ListWorkshopsOutput": {
        "type": "object",
        "properties": {
          "workshops": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "sectionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "title": {
                  "type": "string",
                  "maxLength": 2000
                },
                "summary": {
                  "type": "string",
                  "maxLength": 20000
                },
                "level": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                }
              },
              "required": [
                "id",
                "sectionId",
                "title",
                "summary",
                "level"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "workshops"
        ],
        "additionalProperties": false
      },
      "GetWorkshopOutput": {
        "type": "object",
        "properties": {
          "workshop": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "sectionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "title": {
                "type": "string",
                "maxLength": 2000
              },
              "summary": {
                "type": "string",
                "maxLength": 20000
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "outline": {
                "maxItems": 500,
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        },
                        "title": {
                          "type": "string",
                          "maxLength": 2000
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "PAGE"
                          ]
                        },
                        "resourceId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        }
                      },
                      "required": [
                        "id",
                        "title",
                        "kind",
                        "resourceId"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        },
                        "title": {
                          "type": "string",
                          "maxLength": 2000
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "CODING_LAB"
                          ]
                        },
                        "resourceId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        }
                      },
                      "required": [
                        "id",
                        "title",
                        "kind",
                        "resourceId"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        },
                        "title": {
                          "type": "string",
                          "maxLength": 2000
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "ASSESSMENT_TEST"
                          ]
                        },
                        "resourceId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        }
                      },
                      "required": [
                        "id",
                        "title",
                        "kind",
                        "resourceId"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": [
              "id",
              "sectionId",
              "title",
              "summary",
              "level",
              "outline"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "workshop"
        ],
        "additionalProperties": false
      },
      "GetCodingLabOutput": {
        "type": "object",
        "properties": {
          "lab": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-f\\d]{24}$"
              },
              "versionId": {
                "type": "string",
                "pattern": "^[a-f\\d]{24}$"
              },
              "versionNumber": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMinimum": true,
                "maximum": 9007199254740991
              },
              "title": {
                "type": "string",
                "maxLength": 2000
              },
              "difficulty": {
                "type": "string",
                "enum": [
                  "intro",
                  "easy",
                  "medium",
                  "hard"
                ]
              },
              "language": {
                "type": "string",
                "enum": [
                  "javascript",
                  "typescript"
                ]
              },
              "promptMarkdown": {
                "type": "string",
                "maxLength": 100000
              },
              "hints": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 20000
                }
              },
              "starterCode": {
                "type": "string",
                "maxLength": 100000
              },
              "sampleTests": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "io",
                        "unit"
                      ]
                    },
                    "input": {},
                    "expected": {},
                    "comparator": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "deepEqual",
                            "strictEqual",
                            "numberTolerance",
                            "stringNormalized",
                            "custom"
                          ]
                        },
                        "tolerance": {
                          "type": "number"
                        },
                        "normalizeWhitespace": {
                          "type": "boolean"
                        },
                        "ignoreCase": {
                          "type": "boolean"
                        },
                        "customComparatorId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    "testCode": {
                      "type": "string",
                      "maxLength": 50000
                    },
                    "framework": {
                      "type": "string",
                      "enum": [
                        "jest",
                        "vitest"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "kind"
                  ],
                  "additionalProperties": false
                }
              },
              "entryFnName": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "id",
              "versionId",
              "versionNumber",
              "title",
              "language",
              "promptMarkdown",
              "hints",
              "starterCode",
              "sampleTests"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "lab"
        ],
        "additionalProperties": false
      },
      "ToolError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "NOT_FOUND",
                  "FORBIDDEN",
                  "UPSTREAM_TIMEOUT",
                  "UPSTREAM_UNAVAILABLE",
                  "UPSTREAM_INVALID_RESPONSE",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}
